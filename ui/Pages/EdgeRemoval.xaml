<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,18">
        <TextBlock Text="Edge removal" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Removes Microsoft Edge with its own uninstaller, in any country, using ave9858's UninstallEdge script. WebView2 is not touched."/>

        <CheckBox x:Name="EnableCheck" Style="{StaticResource EnableToggle}" IsChecked="False" Content="Remove Microsoft Edge"/>
        <TextBlock x:Name="UnavailableNote" Style="{StaticResource Muted}" Visibility="Collapsed"/>

        <Border x:Name="NoBrowserWarning" Style="{StaticResource WarningBox}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                           Text="No other browser is installed and the 'Alternative browser' step is off. Removing Edge would leave you without a web browser."/>
                <CheckBox x:Name="ConfirmNoBrowserCheck" Margin="0,4,0,0">
                    <TextBlock TextWrapping="Wrap" Text="I understand. Remove Edge anyway."/>
                </CheckBox>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Why a script?" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Microsoft only lets you uninstall Edge in the European Economic Area (EEA), because of the EU Digital Markets Act. Everywhere else, Switzerland included, Edge's uninstaller refuses."/>
                <TextBlock Style="{StaticResource Body}"
                           Text="The script still runs Edge's own uninstaller, but in a way it accepts in every country: it sets the flag the uninstaller checks, creates an empty placeholder for the old built-in Edge, and starts the uninstaller from a temporary copy of cmd.exe named dllhost.exe. It deletes those temporary files afterwards."/>
                <TextBlock Text="WebView2 is always kept" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="WebView2 is a separate copy of the Edge engine that many apps use to show web content (for example Teams, Outlook, Widgets, game launchers and installers). The script only uninstalls the Edge browser: WebView2 stays, and so does Edge Update, which keeps WebView2 up to date. UDP checks afterwards that WebView2 is still there."/>
                <TextBlock Text="Things to know" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Microsoft does not support removing Edge outside the EEA. Edge may come back after a major Windows feature update. Just run UDP again: the step skips itself when Edge is not installed."/>
                <TextBlock Style="{StaticResource Body}"
                           Text="A few Windows links (some search results, widgets and help links) only open in Edge. Without Edge, Windows says it needs an app to open them. Win11Debloat's recommended settings already turn off Bing results in search and widgets."/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Your antivirus may warn about dllhost.exe in C:\Windows\SystemTemp: that is the script's temporary copy of cmd.exe. If it is blocked, the step is marked as failed and the run continues."/>
                <TextBlock Style="{StaticResource Body}"
                           Text="This step runs after the browser step, so another browser is already installed when Edge is removed."/>
                <TextBlock Text="How to undo" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Reinstall Edge from microsoft.com/edge, or use UDP's restore point."/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                   Text="Source: ave9858's 'Uninstall Microsoft Edge' guide on gist.github.com, file UninstallEdge.ps1, public domain (CC0). Pinned to one revision and checked against its SHA256 (see config/tools.json). UDP does not redistribute it: it downloads it from the gist when it runs."/>
    </StackPanel>
</ScrollViewer>
