<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,18">
        <TextBlock Text="Win11Debloat" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="By Raphire. Removes preinstalled Store apps and turns off telemetry, ads, suggestions and AI features."/>

        <CheckBox x:Name="EnableCheck" Style="{StaticResource EnableToggle}" IsChecked="True" Content="Run Win11Debloat"/>
        <TextBlock x:Name="UnavailableNote" Style="{StaticResource Muted}" Visibility="Collapsed"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="What it does" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Removes a selection of preinstalled apps (the list is maintained by Win11Debloat) and applies registry tweaks for privacy and usability. It runs without a window; its output appears in UDP's log."/>
                <TextBlock Text="What the recommended settings change" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Win11Debloat's own default preset: turns off telemetry and targeted ads, tips and suggestions, lock screen tips, Edge ads, Bing web results and Store suggestions in search, Copilot, Recall, Click to Do and the AI service auto-start; disables widgets; hides the Chat icon; shows file extensions; hides 3D Objects; turns off network access during Modern Standby. The apps to remove are chosen separately below."/>
                <TextBlock Text="Risks" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="A removed app is gone until you reinstall it from the Microsoft Store. Some tweaks hide features you might use (widgets, Copilot). Explorer restarts at the end, so the screen may flicker."/>
                <TextBlock Text="How to undo" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Win11Debloat saves a registry backup before it changes anything and can restore it from its own window (run Win11Debloat again). Reinstall removed apps from the Microsoft Store. The restore point UDP creates first undoes everything at once."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource InfoBox}">
            <TextBlock Style="{StaticResource Body}" Margin="0"
                       Text="Win11Debloat's own Edge removal is never used. Edge is handled by UDP's Edge removal step, which uses a dedicated script for removing Edge outside the European Economic Area."/>
        </Border>

        <TextBlock Text="Apps to remove" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="AppsSummary" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
        <StackPanel x:Name="AppsTools" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="AppsRecommendedButton" Content="Recommended selection" Style="{StaticResource SecondaryButton}" Margin="0"/>
            <Button x:Name="AppsNoneButton" Content="Select none" Style="{StaticResource SecondaryButton}"/>
            <CheckBox x:Name="AppsShowAllCheck" Content="Show apps that are not installed" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Border x:Name="AppsCard" Style="{StaticResource Card}" Padding="12,6">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AppsPanel" Margin="0,0,8,0"/>
            </ScrollViewer>
        </Border>
        <Border x:Name="AppsFallback" Style="{StaticResource WarningBox}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Style="{StaticResource Body}"
                           Text="Win11Debloat's app list could not be loaded (no internet connection, or GitHub could not be reached), so apps cannot be chosen one by one."/>
                <CheckBox x:Name="RemoveDefaultAppsCheck" IsChecked="True" Content="Remove Win11Debloat's recommended selection of apps"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Settings" Style="{StaticResource SectionTitle}"/>
        <RadioButton x:Name="ModeDefaults" GroupName="W11DMode" IsChecked="True" Content="Recommended settings (Win11Debloat's default preset, runs silently)"/>
        <RadioButton x:Name="ModeCustom" GroupName="W11DMode" Content="Custom: choose the settings below"/>

        <Border x:Name="CustomPanel" Style="{StaticResource Card}" Margin="22,6,0,10" Visibility="Collapsed">
            <StackPanel x:Name="CustomOptionsPanel"/>
        </Border>

        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                   Text="Source: github.com/Raphire/Win11Debloat (MIT license). The latest release is downloaded and checked against the SHA256SUMS file published with it."/>
    </StackPanel>
</ScrollViewer>
