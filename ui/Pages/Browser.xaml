<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,18">
        <TextBlock Text="Alternative browser" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Installs another browser before Edge is removed, so you are never left without one."/>

        <CheckBox x:Name="EnableCheck" Style="{StaticResource EnableToggle}" IsChecked="True" Content="Install an alternative browser"/>
        <TextBlock x:Name="UnavailableNote" Style="{StaticResource Muted}" Visibility="Collapsed"/>

        <TextBlock Text="Browser" Style="{StaticResource SectionTitle}"/>
        <RadioButton x:Name="FirefoxRadio" GroupName="Browser" IsChecked="True" Content="Mozilla Firefox (recommended: independent engine, full uBlock Origin support)"/>
        <RadioButton x:Name="ChromeRadio" GroupName="Browser" Content="Google Chrome"/>
        <RadioButton x:Name="BraveRadio" GroupName="Browser" Content="Brave (built-in ad and tracker blocking)"/>
        <TextBlock x:Name="InstalledNote" Style="{StaticResource Muted}" Margin="22,2,0,6"/>

        <TextBlock Text="Privacy extensions" Style="{StaticResource SectionTitle}"/>
        <CheckBox x:Name="ExtensionsCheck" Content="Install privacy extensions automatically through browser policies"/>
        <StackPanel x:Name="ExtensionsPanel" Margin="22,2,0,4"/>
        <Border x:Name="ManagedBox" Style="{StaticResource InfoBox}">
            <TextBlock x:Name="ManagedNote" Style="{StaticResource Body}" Margin="0"/>
        </Border>

        <TextBlock Text="Taskbar" Style="{StaticResource SectionTitle}"/>
        <CheckBox x:Name="TaskbarCheck" IsChecked="True" Content="Replace Edge with this browser on the taskbar"/>
        <TextBlock x:Name="TaskbarNote" Style="{StaticResource Muted}" Margin="22,0,0,4"/>

        <TextBlock Text="Default apps" Style="{StaticResource SectionTitle}"/>
        <CheckBox x:Name="DefaultsCheck" IsChecked="True" Content="Make this browser the default for all its link and file types"/>
        <TextBlock x:Name="DefaultsNote" Style="{StaticResource Muted}" Margin="22,0,0,4"/>

        <Border x:Name="PolicyWarning" Style="{StaticResource WarningBox}">
            <StackPanel>
                <TextBlock Text="Please read: how these two options work" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Windows does not let programs change your taskbar or your default apps directly. UDP therefore uses two policies built into Windows, the ones companies use: the taskbar layout policy and the default associations policy, each with a small file in C:\ProgramData\UDP."/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Windows applies them once, at your next sign-in (after the restart at the end). Afterwards you can still unpin or move anything and choose other default apps in Settings: Windows does not change them back. Windows may mention that some settings are managed by your organization."/>
                <TextBlock Style="{StaticResource Body}" Margin="0"
                           Text="To remove both policies, use 'Revert browser policies created by UDP' on the welcome page. Your current pins and default apps then stay as they are."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="What it changes" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Installs the browser with winget (or the official installer if winget fails). With extensions ticked, UDP writes one policy value, ExtensionSettings, under HKLM\SOFTWARE\Policies for that browser. Policies that already exist are kept."/>
                <TextBlock Text="Default browser" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="UDP never forges the protected settings where Windows stores your default apps. With 'Make this browser the default' ticked, it uses the default associations policy (Windows Pro, Enterprise or Education). Otherwise, and on Windows Home, it opens Settings > Default apps at the end of this step and shows you the two clicks needed."/>
                <TextBlock Text="How to undo" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Body}"
                           Text="Uninstall the browser from Settings > Apps. Remove the extension policies with 'Revert browser policies created by UDP' on the welcome page, or run: UDP.ps1 -RevertBrowserPolicies. Only the entries UDP added are removed."/>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>
